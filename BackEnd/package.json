{
  "name": "printflow-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "clean:demo": "node src/db/cleanDemoData.js",
    "migrate": "node src/db/runMigrations.js",
    "test": "node --test",
    "start": "node src/server.js",
    "backup": "node src/db/backupDatabase.js",
    "restore": "node src/db/restoreDatabase.js",
    "storage:smoke": "node ../scripts/r2-smoke.mjs",
    "storage:migrate:r2": "node ../scripts/migrate-local-print-files-to-r2.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "exceljs": "^4.4.0",
    "pg": "^8.23.0",
    "ws": "8.18.3"
  }

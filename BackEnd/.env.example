# Copie este arquivo para .env.local somente para desenvolvimento local.
# Em producao, configure estas variaveis exclusivamente no provedor de deploy (Render).
PORT=3333
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Apenas para desenvolvimento enquanto a autenticacao real nao estiver pronta.
# Em producao, o tenant deve vir do usuario autenticado/JWT.
ALLOW_DEMO_TENANT=false

# Sessao local expira em 7 dias. Use um valor menor em producao, se necessario.
AUTH_TOKEN_TTL_SECONDS=604800
AUTH_SECRET=troque-por-um-segredo-longo
DATA_ENCRYPTION_KEY=troque-por-uma-chave-longa-e-privada

# Protecao basica contra abuso por IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_MAX_REQUESTS=12
RATE_LIMIT_SHARED=false
MAX_CONCURRENT_REQUESTS_PER_IP=25
# Em producao no Render, usa o IP confirmado pelo Cloudflare. Configure o
# cabecalho equivalente do proxy apenas se o provedor garantir que ele e sobrescrito.
TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP

# Origens web autorizadas, separadas por virgula. Nunca use * em producao.
CORS_ALLOWED_ORIGINS=https://filamind.com.br,https://www.filamind.com.br,https://admin.exemplo.com
MINIMUM_SUPPORTED_AGENT_VERSION=0.1.10

# Object storage. Use local durante os testes; habilite R2 somente depois de
# validar as credenciais no provedor de deploy. Nunca coloque segredos no Git.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_DIR=storage/object-storage
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGN_EXPIRES_SECONDS=900

# Lista privada, separada por virgula. Nunca publique estes e-mails no FrontEnd ou no Git.
PLATFORM_SUPER_ADMIN_EMAILS=
# Allowlist privada de contas de desenvolvimento com recursos completos, separada dos superadmins.
PLATFORM_DEVELOPER_EMAILS=

# Convites de usuarios por e-mail (Resend). Configure apenas no provedor de deploy.
APP_PUBLIC_URL=https://filamind.com.br
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
EMAIL_FROM=Filamind <no.reply@filamind.com.br>
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_REQUIRE_MFA_FOR_PRIVILEGED=false

# Mercado Pago Assinaturas: local deve usar Access Token de TESTE, Render usa o token real.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_TEST_PAYER_EMAIL=

# Operacao e recuperacao do Agent.
PRINT_QUEUE_WATCHDOG_INTERVAL_MS=60000
AGENT_OFFLINE_AFTER_MS=90000
AGENT_HEALTH_WATCHDOG_INTERVAL_MS=30000

# Assinaturas internas: aviso, e carencia para pagamentos nao regularizados.
SUBSCRIPTION_WATCHDOG_INTERVAL_MS=3600000
SUBSCRIPTION_WARNING_MS=259200000
SUBSCRIPTION_GRACE_MS=259200000

# Backup local por pg_dump. Nao use um diretorio publico.
BACKUP_DIR=backups
BACKUP_RETENTION_COUNT=14

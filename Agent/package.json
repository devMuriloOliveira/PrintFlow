{
  "name": "fila-agent",
  "version": "0.1.26",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "dotnet run --project windows-host/FilaAgent.csproj --configuration Release",
    "start:tray": "dotnet run --project windows-host/FilaAgent.csproj --configuration Release",
    "dev": "dotnet watch --project windows-host/FilaAgent.csproj run",
    "start:node-reference": "node src/index.js",
    "dev:node-reference": "nodemon src/index.js",
    "test": "node --check src/index.js && node --test test/*.test.js",
    "diagnostics": "node scripts/fila-agent-diagnostics.mjs",
    "support-bundle": "node scripts/fila-agent-support-bundle.mjs",
    "generate:icon": "node scripts/generate-windows-icon.js",
    "build:windows": "dotnet run --project windows-release-tool/FilaAgent.ReleaseTool.csproj --configuration Release -- package",
    "build:windows:dev-signed": "dotnet run --project windows-release-tool/FilaAgent.ReleaseTool.csproj --configuration Release -- package --sign-dev --require-persisted-certificate",
    "install:agent": "npm run build:windows && dist\\Fila-Agent-Setup.exe",
    "uninstall:agent": "\"%LOCALAPPDATA%\\PrintFlowAgent\\FilaAgentSetup.exe\" --uninstall"
  },
  "dependencies": {
    "axios": "^1.0.0",
    "dotenv": "^17.0.0",
    "form-data": "^4.0.6",
    "mqtt": "^5.15.2",
    "serialport": "^13.0.0",
    "uuid": "^11.0.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
